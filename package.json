{
  "name": "leash",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "packageManager": "pnpm@10.15.1",
  "scripts": {
    "test": "pnpm test:contracts && pnpm test:ts",
    "test:contracts": "cd contracts && forge test",
    "test:ts": "pnpm -r --if-present test",
    "status": "bash scripts/status.sh",
    "deploy:whitechain": "bash scripts/deploy-whitechain.sh",
    "facilitator": "pnpm --filter @leash/facilitator start",
    "merchant": "pnpm --filter @leash/merchant start",
    "owner": "pnpm --filter @leash/agent owner",
    "agent": "pnpm --filter @leash/agent agent",
    "web": "pnpm --filter @leash/web dev",
    "owner-signer": "tools/owner-signer/.venv/bin/python tools/owner-signer/falcon_signer.py serve --key keys/owner.json --port 8787",
    "build:falcon-wasm": "bash tools/falcon-wasm/build.sh",
    "hedera:bootstrap": "pnpm --filter @leash/hedera run bootstrap",
    "verify-log": "pnpm --filter @leash/facilitator run verify-log"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vitest": "^5.1.0"
  }
}